<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Cash Management</title>
  <link rel="stylesheet" href="/assets/styles.css"/>
</head>
<body class="bank-bg">
    <div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="bank-title mb-1"> Cash Management</h1>
            <p class="text-muted mb-0"> Dashboard</p>
            </div>
        <a href="/" class="btn bank-home-btn">Back to Home</a>
        </div>

   <div class="row g-4 mb-4">
       <div class="col-lg-6">
           <div class= "card bank-card h-100">
           <div class="card-body">
            <p class="text-muted mb-2">Balance</p>
         <h2 class="display-5 fw-semibold bank-balance">£{{balance}}</h2>
               <p class="text-muted small mb-0">Current cash in your account</p>
               </div>
               </div>
            </div>

     <div class="col-lg-3">
        <div class="card bank-card h-100">
          <div class="card-body">
             <p class="text-muted mb-2">Total Deposits</p>
               <h3 class="fw-semibold bank-positive">£{{totalDeposits}}</h3>
          </div>
        </div>
      </div>

<div class="col-lg-3">
        <div class="card bank-card h-100">
          <div class="card-body">
            <p class="text-muted mb-2">Total Withdrawals</p>
            <h3 class="fw-semibold bank-negative">£{{totalWithdrawals}}</h3>
          </div>
        </div>
      </div>
     </div>

<div class="card bank-card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 mb-0">Recent Transactions</h2>
          <span class="text-muted small">Last 5–10</span>
        </div>

 <div class="table-responsive">
   <table class="table align-middle bank-table">
     <thead>
        <tr>
         <th>Date</th>
           <th>Type</th>
             <th class="text-end">Amount</th>
              <th class="text-end">Balance After</th>
          </tr>
        </thead>
      <tbody>

 {{#each recentTransactions}}
    <tr class="{{rowClass}}">
     <td>{{date}}</td>
         <td>
          <span class="badge {{badgeClass}}">
             {{type}}
               </span>
                </td>
                 <td class="text-end">{{amount}}</td>
                  <td class="text-end">{{balanceAfter}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
           </div>
       </div>
      </div>
    </div>
   </body>
  </html>