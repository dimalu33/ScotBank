<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>Investor Portfolio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css"/>
</head>
<body class="bank-bg">
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="bank-title mb-1">Investor Portfolio</h1>
            <p class="text-muted mb-0">Investment Overview</p>
        </div>
        <a href="/" class="btn bank-home-btn">Back to Home</a>
    </div>

    {{#if missingPrices}}
        <div class="alert alert-warning">
            ⚠️ Some positions are missing EoD price data — book value shown instead.
        </div>
    {{/if}}

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card bank-card h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Cash Balance</p>
                    <h2 class="display-6 fw-semibold bank-balance">£{{cash}}</h2>
                    <p class="text-muted small mb-0">Available cash in account</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bank-card h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Book Value</p>
                    <h3 class="fw-semibold">£{{totalBookValue}}</h3>
                    <p class="text-muted small mb-0">Total amount invested</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bank-card h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Market Value</p>
                    <h3 class="fw-semibold">£{{totalMarketValue}}</h3>
                    <p class="text-muted small mb-0">Current value of holdings</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bank-card h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Unrealised P&amp;L</p>
                    <h3 class="fw-semibold {{#if pnlPositive}}bank-positive{{else}}bank-negative{{/if}}">
                        £{{pnl}} ({{pnlPct}}%)
                    </h3>
                    <p class="text-muted small mb-0">Unrealised gain/loss vs book value</p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bank-card h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Portfolio Value</p>
                    <h2 class="display-6 fw-semibold bank-balance">£{{totalPortfolioValue}}</h2>
                    <p class="text-muted small mb-0">Cash + market value of all holdings</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Positions Table -->
    <div class="card bank-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Current Positions</h2>
                <span class="text-muted small">{{positions.size}} holdings</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle bank-table">
                    <thead>
                    <tr>
                        <th>Ticker</th>
                        <th class="text-end">Shares</th>
                        <th class="text-end">Book Price</th>
                        <th class="text-end">Market Price</th>
                        <th class="text-end">Book Value</th>
                        <th class="text-end">Market Value</th>
                        <th class="text-end">P&amp;L £</th>
                        <th class="text-end">P&amp;L %</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#each positions}}
                        <tr>
                            <td><strong>{{ticker}}</strong></td>
                            <td class="text-end">{{shares}}</td>
                            <td class="text-end">£{{bookPrice}}</td>
                            <td class="text-end">
                                {{#if hasPriceData}}£{{marketPrice}}{{else}}<span class="text-muted">N/A</span>{{/if}}
                            </td>
                            <td class="text-end">£{{bookValue}}</td>
                            <td class="text-end">
                                {{#if hasPriceData}}£{{marketValue}}{{else}}<span class="text-muted">N/A</span>{{/if}}
                            </td>
                            <td class="text-end {{#if hasPriceData}}{{#if pnlPositive}}bank-positive{{else}}bank-negative{{/if}}{{/if}}">
                                {{#if hasPriceData}}£{{pnl}}{{else}}<span class="text-muted">N/A</span>{{/if}}
                            </td>
                            <td class="text-end {{#if hasPriceData}}{{#if pnlPositive}}bank-positive{{else}}bank-negative{{/if}}{{/if}}">
                                {{#if hasPriceData}}{{pnlPct}}%{{else}}<span class="text-muted">N/A</span>{{/if}}
                            </td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
</body>
</html>