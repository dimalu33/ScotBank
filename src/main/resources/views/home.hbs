<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Scotbank</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css"/>
  <style>
    .login-suggestion { cursor: pointer; color: #0a2a5c; text-decoration: underline; }
    .hidden-ui { display: none !important; }
    #loader { display: none; }
  </style>
</head>
<body class="bank-bg">
  <div class="container py-5">
    <div class="card bank-card">
      <div class="card-body p-5 text-center">
        <h1 class="bank-title mb-3">Scotbank</h1>

        <!-- ЛОГІН -->
        <div id="login-view">
          <p class="text-muted mb-4">Enter your full name to access the system</p>
          <div class="mb-3 mx-auto" style="max-width: 400px;">
            <input type="text" id="nameInput" class="form-control mb-2" placeholder="e.g. Galina Osinski V">
            <p class="small text-muted">
              Suggestions:
              <span class="login-suggestion" onclick="fillName('Galina Osinski V')">Galina Osinski V</span>
              <span class="login-suggestion" onclick="fillName('Valentine Rippin DDS')">Valentine Rippin DDS</span>
            </p>
            <button id="loginBtn" onclick="doLogin()" class="btn bank-primary w-100">Login</button>
            <div id="loader" class="mt-2 text-primary small">Connecting to API...</div>
          </div>
        </div>

        <div id="dashboard-view" class="hidden-ui">
          <p class="text-muted mb-4">Welcome, <span id="userNameDisplay" class="fw-bold"></span></p>

          <div class="d-flex justify-content-center flex-wrap gap-3">
            <a id="link-cash" href="#" class="btn bank-primary">Cash Dashboard</a>

            <a id="link-portfolio" href="#" class="btn bank-primary">Investor Portfolio</a>
            <a id="link-eval" href="#" class="btn bank-primary">Portfolio Evaluation</a>
            <a id="link-tax" href="#" class="btn bank-primary">Capital Gains</a>
          </div>

          <div class="mt-5">
            <button onclick="doLogout()" class="btn btn-sm btn-outline-danger">Logout</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    function fillName(name) {
      document.getElementById('nameInput').value = name;
    }

    async function doLogin() {
      const inputName = document.getElementById('nameInput').value.trim();
      if (!inputName) return alert("Please enter a name");

      const btn = document.getElementById('loginBtn');
      const loader = document.getElementById('loader');

      btn.disabled = true;
      loader.style.display = 'block';

      try {
        const response = await fetch('/api/investors');
        const data = await response.json();

        const investor = data.investors.find(inv => inv.name.toLowerCase() === inputName.toLowerCase());

        if (investor) {
          localStorage.setItem('scotbank_id', investor.id);
          localStorage.setItem('scotbank_name', investor.name);
          render();
        } else {
          alert("Investor not found in API. Please check spelling.");
        }
      } catch (err) {
        console.error(err);
        alert("Error fetching data from API");
      } finally {
        btn.disabled = false;
        loader.style.display = 'none';
      }
    }

    function doLogout() {
      localStorage.clear();
      render();
    }

    function render() {
      const id = localStorage.getItem('scotbank_id');
      const name = localStorage.getItem('scotbank_name');

      const loginView = document.getElementById('login-view');
      const dashView = document.getElementById('dashboard-view');

      if (id && name) {
        loginView.classList.add('hidden-ui');
        dashView.classList.remove('hidden-ui');
        document.getElementById('userNameDisplay').innerText = name;

        document.getElementById('link-cash').href = `/cash/${id}`;
        document.getElementById('link-portfolio').href = `/portfolio.html?id=${id}`;
        document.getElementById('link-eval').href = `/portfolio/${id}`;
        document.getElementById('link-tax').href = `/tax.html?id=${id}`;
      } else {
        loginView.classList.remove('hidden-ui');
        dashView.classList.add('hidden-ui');
      }
    }

    window.onload = render;
  </script>
</body>
</html>